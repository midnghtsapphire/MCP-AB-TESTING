### **`src/index.ts`**
import express from 'express';
import { Server as MCTServer } from './mct/server';
import routes from './api/routes';
const app = express();
const port = process.env.PORT || 3000;
app.use(express.json());
app.use(routes);
const mctServer = new MCTServer();
mctServer.start();
app.listen(port, () => {
  console.log(`Server running on port ${port}`);
});
### **`src/api/routes.ts`**
import { Router } from 'express';
import { getTestResults, createTest, updateTest } from '../services/testService';
const router = Router();
router.get('/tests/results', getTestResults);
router.post('/tests/create', createTest);
router.put('/tests/update/:id', updateTest);
export default router;
### **`src/db/schema.ts`**
import { Entity, PrimaryGeneratedColumn, Column, createConnection } from 'typeorm';
@Entity()
export class Test {
  @PrimaryGeneratedColumn()
  id: number;
  @Column()
  name: string;
  @Column()
  variantA: string;
  @Column()
  variantB: string;
  @Column({ default: 0 })
  variantAResult: number;
  @Column({ default: 0 })
  variantBResult: number;
}
export async function initializeDatabase() {
  await createConnection({
    type: 'sqlite',
    database: 'db.sqlite',
    entities: [Test],
    synchronize: true,
  });
}
### **`src/mct/server.ts`**
export class Server {
  start() {
    console.log('MCT Server started');
  }
}
